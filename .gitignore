# Local workspace (not in repo)
*.code-workspace

# Dependencies (npm run build-social-card)
node_modules/

# Wrangler writes local state/tmp into the project root — which is also the
# assets directory ([assets] directory = "."), so it must never be committed.
.wrangler/

# Per-machine Claude Code settings (launch.json is shared; this is not)
.claude/settings.local.json

# Local Worker secrets for `wrangler dev` (real secrets live in
# `wrangler secret put`, never in the repo)
.dev.vars
